{
  "name": "otel-data-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "codegen": "graphql-codegen",
    "codegen:watch": "graphql-codegen --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\"",
    "lint:spell": "cspell --no-progress --no-summary --gitignore \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \".github/**/*.{md,yml,yaml}\" \"docs/**/*.md\" \"*.md\" \"*.json\" \"*.ts\" \"*.js\" \"*.sh\" \"Dockerfile\" \"Makefile\" \"index.html\" \"nginx.conf\"",
    "lint:docker": "if command -v hadolint >/dev/null 2>&1; then hadolint Dockerfile; else echo '⚠️  hadolint not installed, skipping Dockerfile lint (install: https://github.com/hadolint/hadolint#install)'; fi",
    "lint:all": "npm run lint && npm run lint:md && npm run lint:docker && npm run lint:spell && npm run format:check",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\" \"**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\" \"**/*.md\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@apollo/client": "^4.1.6",
    "@fontsource-variable/geist": "^5.2.8",
    "@newrelic/browser-agent": "^1.314.0",
    "@stuartshay/otel-graphql-types": "1.0.597",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "graphql": "^16.14.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.21.0",
    "oidc-client-ts": "^3.5.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.0",
    "react-calendar-heatmap": "^1.10.0",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@graphql-codegen/cli": "^7.1.3",
    "@graphql-codegen/typescript": "^6.0.1",
    "@graphql-codegen/typescript-operations": "^6.0.4",
    "@graphql-codegen/typescript-react-apollo": "^4.4.1",
    "@playwright/test": "^1.61.0",
    "@sonar/scan": "^5.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.7",
    "@types/react-calendar-heatmap": "^1.9.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.9",
    "cspell": "^10.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.0.3",
    "markdownlint-cli2": "^0.23.0",
    "prettier": "^3.8.1",
    "shadcn": "^4.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{ts,tsx,js,md,yml,yaml,sh,html}": [
      "cspell --no-progress --no-summary --no-must-find-files"
    ],
    "*.{json,css}": [
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix",
      "prettier --write"
    ],
    "Dockerfile": [
      "bash -c 'if command -v hadolint >/dev/null 2>&1; then hadolint Dockerfile; else echo \"⚠️  hadolint not installed, skipping Dockerfile lint (install: https://github.com/hadolint/hadolint#install)\"; fi'"
    ]
  }
}
