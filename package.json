{
  "name": "otel-data-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "codegen": "graphql-codegen",
    "codegen:watch": "graphql-codegen --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\"",
    "lint:spell": "cspell --no-progress --no-summary --gitignore \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \".github/**/*.{md,yml,yaml}\" \"docs/**/*.md\" \"*.md\" \"*.json\" \"*.ts\" \"*.js\" \"*.sh\" \"Dockerfile\" \"Makefile\" \"index.html\" \"nginx.conf\"",
    "lint:all": "npm run lint && npm run lint:md && npm run lint:spell",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\" \"**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\" \"**/*.md\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@apollo/client": "^4.1.6",
    "@fontsource-variable/geist": "^5.2.8",
    "@newrelic/browser-agent": "^1.310.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@stuartshay/otel-graphql-types": "1.0.863",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "graphql": "^16.13.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.0.0",
    "oidc-client-ts": "^3.5.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-calendar-heatmap": "^1.10.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@graphql-codegen/cli": "^6.2.1",
    "@graphql-codegen/typescript": "^5.0.9",
    "@graphql-codegen/typescript-operations": "^5.0.9",
    "@graphql-codegen/typescript-react-apollo": "^4.4.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.7",
    "@types/react-calendar-heatmap": "^1.9.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.0",
    "cspell": "^10.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.0",
    "lint-staged": "^16.4.0",
    "markdownlint-cli2": "^0.22.0",
    "prettier": "^3.8.1",
    "shadcn": "^4.1.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{ts,tsx,js,md,yml,yaml,sh,html}": [
      "cspell --no-progress --no-summary --no-must-find-files"
    ],
    "*.{json,css}": [
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix",
      "prettier --write"
    ]
  }
}
